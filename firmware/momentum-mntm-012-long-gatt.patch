diff --git a/targets/f7/ble_glue/gap.c b/targets/f7/ble_glue/gap.c
index 38fc5e4..02b9178 100644
--- a/targets/f7/ble_glue/gap.c
+++ b/targets/f7/ble_glue/gap.c
@@ -359,7 +359,7 @@ static void gap_init_svc(Gap* gap, const GapRootSecurityKeys* root_keys) {
     aci_gap_init(
         GAP_PERIPHERAL_ROLE,
         0,
-        strlen(name),
+        GAP_DEVICE_NAME_MAX, // Patch: room for a name longer than the advertised one
         &gap->service.gap_svc_handle,
         &gap->service.dev_name_char_handle,
         &gap->service.appearance_char_handle);
@@ -660,3 +660,14 @@ void gap_emit_ble_beacon_status_event(bool active) {
     gap->on_event_cb(event, gap->context);
     FURI_LOG_I(TAG, "Beacon status event: %d", active);
 }
+
+// Patch: sets the GAP Device Name characteristic (what hosts read after connecting), which can be
+// longer than the 20-character advertised name.
+bool gap_set_device_name(const char* name) {
+    if(!gap || !name) return false;
+    size_t len = strlen(name);
+    if(len > GAP_DEVICE_NAME_MAX) len = GAP_DEVICE_NAME_MAX;
+    return aci_gatt_update_char_value(
+               gap->service.gap_svc_handle, gap->service.dev_name_char_handle, 0, len, (const uint8_t*)name) ==
+           BLE_STATUS_SUCCESS;
+}
